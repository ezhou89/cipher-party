{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cipher-party",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-05",
  "vars": {
    "CANONICAL_ORIGIN": "http://127.0.0.1:5173"
  },
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
