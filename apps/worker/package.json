{
  "name": "@cipher-party/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "WRANGLER_SEND_METRICS=false XDG_CONFIG_HOME=../../.wrangler wrangler dev --config wrangler.dev.jsonc",
    "build": "WRANGLER_SEND_METRICS=false XDG_CONFIG_HOME=../../.wrangler wrangler deploy --dry-run --config wrangler.jsonc",
