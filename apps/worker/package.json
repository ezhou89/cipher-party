  "dependencies": {
    "@cipher-party/game-core": "workspace:*",
    "@cipher-party/protocol": "workspace:*",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.4",
    "@cloudflare/workers-types": "^5.20260904.1",
    "wrangler": "^4.129.0"
  }
}
